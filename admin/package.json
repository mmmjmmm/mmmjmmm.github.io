{
  "name": "lemonade-blog-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run typecheck && npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "package:fc": "npm run build && node scripts/build-fc-package.mjs",
    "deploy:fc": "npm run package:fc && npx --yes @serverless-devs/s3@3.1.10 deploy -y",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/server/index.js",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@uiw/react-codemirror": "^4.25.11",
    "cookie": "^2.0.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
