---
import Pagination from '../components/Pagination.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { paginatePosts } from '../lib/blog';
import { getPublishedPosts } from '../lib/posts';
import { withBase } from '../lib/urls';

const posts = await getPublishedPosts();
const page = paginatePosts(posts, 1, SITE.pageSize);
---

<BaseLayout>
  <h1 class="visually-hidden">{SITE.title}</h1>
  <section
    class="reading-gate shell"
    aria-label="阅读入口"
    data-reading-gate
    data-scroll-state="idle"
  >
    <a class="reading-gate__cta" href="#latest-posts" data-reading-start>
      <div>blog</div>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3v17m0 0 6-6m-6 6-6-6"></path>
      </svg>
    </a>
    <p class="slogan">"When life gives you lemons, make lemonade."</p>
  </section>

  <section
    class="archive-section shell"
    id="latest-posts"
    aria-labelledby="latest-heading"
    data-scroll-state="idle"
  >
    <header class="section-heading">
      <div>
        <p class="eyebrow">ARCHIVE / {new Date().getFullYear()}</p>
        <h2 id="latest-heading">最新文章</h2>
      </div>
      <a class="text-link" href={withBase('tags/')}
        >浏览所有标签 <span aria-hidden="true">↗</span></a
      >
    </header>
    <PostList posts={page.items} />
    <Pagination currentPage={page.currentPage} totalPages={page.totalPages} />
  </section>
</BaseLayout>

<script>
  const readingGate = document.querySelector<HTMLElement>('[data-reading-gate]');
  const startReading = document.querySelector<HTMLAnchorElement>('[data-reading-start]');
  const articleArchive = document.querySelector<HTMLElement>('#latest-posts');

  startReading?.addEventListener('click', (event) => {
    if (!readingGate || !articleArchive) return;

    event.preventDefault();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    readingGate.dataset.scrollState = 'departing';
    articleArchive.dataset.scrollState = reduceMotion ? 'arrived' : 'arriving';
    articleArchive.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });

    if (reduceMotion) {
      readingGate.dataset.scrollState = 'idle';
      window.history.replaceState(null, '', '#latest-posts');
      return;
    }

    window.setTimeout(() => {
      readingGate.dataset.scrollState = 'idle';
      articleArchive.dataset.scrollState = 'arrived';
      window.history.replaceState(null, '', '#latest-posts');
    }, 420);
  });
</script>
